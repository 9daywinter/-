# 复制一份为 .env 再填 Key。智谱开放平台注册就送额度：https://open.bigmodel.cn
# glm-4v-flash（截图识别）和 glm-4-flash（文本）都有免费额度，四天开发足够
#
# 用阿里云百炼的话改成：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-vl-plus
#   LLM_TEXT_MODEL=qwen-turbo
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4v-flash
LLM_TEXT_MODEL=glm-4-flash

# ---------- 语音识别 ASR（录音 → 文字 → 日程） ----------
# 只依赖 OpenAI 兼容的 /audio/transcriptions 协议。不填则录音按钮降级为提示，手填/打字照常。
# 国内推荐阿里云百炼（有免费额度）：
#   ASR_API_KEY=sk-xxxx          # 百炼 API Key（可与上面的 LLM 共用一个）
#   ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   ASR_MODEL=paraformer-v2
# 直接用 OpenAI：
#   ASR_API_KEY=sk-xxxx
#   ASR_BASE_URL=https://api.openai.com/v1
#   ASR_MODEL=whisper-1
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
